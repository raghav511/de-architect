{
  "name": "Data Architect · AI foundations (agents, evals, MCP)",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.11-bookworm",
  "features": { "ghcr.io/devcontainers/features/github-cli:1": {} },
  "hostRequirements": { "cpus": 2, "memory": "8gb" },
  "workspaceFolder": "/workspaces/de-architect/projects/ai-foundations",
  "postCreateCommand": "cd /workspaces/de-architect/projects/ai-foundations && pip install -r requirements.txt && cp -n .env.example .env",
  "customizations": { "vscode": { "extensions": ["ms-python.python"] }, "codespaces": { "openFiles": ["projects/ai-foundations/README.md"] } }
}

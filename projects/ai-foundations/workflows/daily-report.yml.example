# Copy to .github/workflows/daily-report.yml in YOUR repo, and add the secret API_KEY (Settings → Secrets → Actions).
name: daily-report
on:
  schedule: [{cron: "30 2 * * *"}]   # 08:00 IST
  workflow_dispatch: {}
permissions: {contents: write}
jobs:
  report:
    runs-on: ubuntu-latest
    defaults: {run: {working-directory: projects/ai-foundations}}
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with: {python-version: "3.11"}
      - run: python automations/daily_report.py
        env: {PROVIDER: gemini, API_KEY: "${{ secrets.API_KEY }}"}
      - run: |
          git config user.name "daily-report-bot"
          git config user.email "actions@users.noreply.github.com"
          git add reports/daily && git commit -m "daily report $(date +%F)" || echo "nothing to commit"
          git push
